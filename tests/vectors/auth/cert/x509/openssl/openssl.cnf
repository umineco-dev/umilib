# The configuration of make.sh: names, extensions and the CA database.
[req]
prompt = no
distinguished_name = dn_root
utf8 = yes
string_mask = utf8only

[dn_root]
C = JP
O = umilib
CN = umilib Root CA

[dir_san]
C = JP
O = umilib
CN = Directory Name

[dir_nc]
C = JP
O = umilib

[dir_crl]
C = JP
O = umilib
CN = CRL Issuer

[root]
basicConstraints = critical, CA:true
keyUsage = critical, keyCertSign, cRLSign
subjectKeyIdentifier = hash

[intermediate]
basicConstraints = critical, CA:true, pathlen:0
keyUsage = critical, keyCertSign, cRLSign, digitalSignature
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always, issuer:always
nameConstraints = critical, permitted;DNS:example.com, permitted;IP:192.0.2.0/255.255.255.0, permitted;IP:2001:db8::/ffff:ffff::, permitted;email:example.com, permitted;dirName:dir_nc, excluded;DNS:bad.example.com
certificatePolicies = @policy, 2.5.29.32.0
policyConstraints = requireExplicitPolicy:0, inhibitPolicyMapping:1
inhibitAnyPolicy = 2
policyMappings = 1.3.6.1.4.1.55555.1:1.3.6.1.4.1.55555.2
crlDistributionPoints = URI:http://crl.example.com/root.crl
authorityInfoAccess = OCSP;URI:http://ocsp.example.com/, caIssuers;URI:http://ca.example.com/root.der

[policy]
policyIdentifier = 1.3.6.1.4.1.55555.1
CPS.1 = "https://example.com/cps"
userNotice.1 = @notice

[notice]
explicitText = "Explicit text"
organization = "umilib"
noticeNumbers = 1, 2, 3

[leaf]
basicConstraints = critical, CA:false
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth, clientAuth
subjectAltName = DNS:www.example.com, DNS:example.com, IP:192.0.2.1, IP:2001:db8::1, email:user@example.com, URI:https://www.example.com/, dirName:dir_san, RID:1.2.3.4, otherName:1.3.6.1.4.1.311.20.2.3;UTF8:user@example.com
issuerAltName = URI:https://ca.example.com/
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid
crlDistributionPoints = crldp
freshestCRL = URI:http://crl.example.com/delta.crl
authorityInfoAccess = OCSP;URI:http://ocsp.example.com/
subjectInfoAccess = caRepository;URI:http://repository.example.com/
certificatePolicies = 1.3.6.1.4.1.55555.2

[crldp]
fullname = URI:http://crl.example.com/intermediate.crl
reasons = keyCompromise, CACompromise
CRLissuer = dirName:dir_crl

[self]
basicConstraints = critical, CA:true
keyUsage = critical, keyCertSign, cRLSign, digitalSignature
subjectKeyIdentifier = hash

[kem]
basicConstraints = critical, CA:false
keyUsage = critical, keyEncipherment
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid

[agreement]
basicConstraints = critical, CA:false
keyUsage = critical, keyAgreement
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid

[csr]
prompt = no
distinguished_name = dn_csr
attributes = csr_attributes
req_extensions = csr_extensions
utf8 = yes
string_mask = utf8only

[dn_csr]
C = JP
O = umilib
CN = csr.example.com

[csr_attributes]
challengePassword = password1234
unstructuredName = Unstructured Name

[csr_extensions]
subjectAltName = DNS:csr.example.com
keyUsage = critical, digitalSignature

[ca]
default_ca = root_ca

[root_ca]
database = index.txt
crlnumber = crlnumber
default_md = sha256
default_crl_days = 30
crl_extensions = crl_extensions

[crl_extensions]
authorityKeyIdentifier = keyid:always
issuerAltName = URI:https://ca.example.com/
